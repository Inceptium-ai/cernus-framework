{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cernus.ai/schemas/ingest-batch.schema.json",
  "title": "Cernus Ingest Batch",
  "description": "What a connector produces and what the server accepts: a bag of normalized objects from one ingest run.",
  "type": "object",
  "required": ["apiVersion", "kind", "source", "produced_at"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "cernus.ai/v0" },
    "kind": { "const": "IngestBatch" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "produced_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "systems": { "type": "array", "items": { "$ref": "system.schema.json" } },
    "deployments": { "type": "array", "items": { "$ref": "deployment.schema.json" } },
    "assets": { "type": "array", "items": { "$ref": "asset.schema.json" } },
    "findings": { "type": "array", "items": { "$ref": "finding.schema.json" } },
    "sboms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "format", "document"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "format": { "enum": ["cyclonedx-json", "spdx-json"] },
          "asset_id": { "type": ["string", "null"] },
          "document": { "type": "object" }
        }
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "evidence-record.schema.json" } }
  }
}
